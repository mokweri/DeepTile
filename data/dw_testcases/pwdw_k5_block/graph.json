  "nodes": [
    {
      "id": "expand",
      "op": "conv2d",
      "inputs": {
        "ifm": "ifm",
        "weight": "expand_w",
        "bias": "expand_b"
      },
      "outputs": {
        "ofm": "expand_out"
      },
      "attrs": {
        "kernel": [
          1,
          1
        ],
        "stride": [
          1,
          1
        ],
        "padding": [
          0,
          0,
          0,
          0
        ],
        "dilation": [
          1,
          1
        ],
        "groups": 1
      },
      "post_ops": {
        "relu": true
      }
    },
    {
      "id": "dw",
      "op": "conv2d",
      "inputs": {
        "ifm": "expand_out",
        "weight": "dw_w",
        "bias": "dw_b"
      },
      "outputs": {
        "ofm": "dw_out"
      },
      "attrs": {
        "kernel": [
          5,
          5
        ],
        "stride": [
          1,
          1
        ],
        "padding": [
          2,
          2,
          2,
          2
        ],
        "dilation": [
          1,
          1
        ],
        "groups": 240
      },
      "post_ops": {
        "relu": true
      }
    },
    {
      "id": "project",
      "op": "conv2d",
      "inputs": {
        "ifm": "dw_out",
        "weight": "project_w",
        "bias": "project_b",
        "residual": "ifm"
      },
      "outputs": {
        "ofm": "project_out"
      },
      "attrs": {
        "kernel": [
          1,
          1
        ],
        "stride": [
          1,
          1
        ],
        "padding": [
          0,
          0,
          0,
          0
        ],
        "dilation": [
          1,
          1
        ],
        "groups": 1
      },
      "post_ops": {
        "residual_add": true,
        "post_add_relu": false
      }
    }
  ]
}